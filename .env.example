# Expo inlines EXPO_PUBLIC_* at bundle time (SDK 49+).
# Copy this file to .env and edit values. Do not commit .env.

# Base URL for app/services/api (apisauce client in app/services/api/api.ts).
# Read by app/config/config.dev.ts and app/config/config.prod.ts.
# The default in config.dev.ts is the Ignite rss2json demo host used by getEpisodes().
EXPO_PUBLIC_API_URL=https://api.example.com/
